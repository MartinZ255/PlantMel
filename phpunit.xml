<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         defaultTestSuite="Unit,Feature"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <!--
            Bekannte Defekte: Tests prüfen das KORREKTE Sollverhalten und sind
            deshalb absichtlich rot. Sie laufen NICHT im Default mit (siehe
            defaultTestSuite oben), sondern nur gezielt mit der Option
            testsuite=KnownDefects (XML-Kommentare erlauben keinen Doppelstrich).
            Siehe tests/KnownDefects/README.md.
        -->
        <testsuite name="KnownDefects">
            <directory>tests/KnownDefects</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <!-- Feste Werte, damit die Tests unabhaengig von einer lokalen .env bzw. der CI-.env laufen. -->
        <env name="APP_DEBUG" value="false"/>
        <env name="APP_URL" value="http://localhost"/>
        <env name="APP_LOCALE" value="de"/>
        <env name="APP_FALLBACK_LOCALE" value="en"/>
        <!--
            Fester Schlüssel NUR für die Testsuite. Er ist kein Geheimnis, wird
            nirgends sonst verwendet und darf niemals in einer echten Umgebung
            (lokal, Staging, Produktion) als APP_KEY eingesetzt werden.
            Er sorgt dafür, dass Tests ohne .env lauffähig sind.
        -->
        <env name="APP_KEY" value="base64:V4WclyiMrJRsxxhOeRQnA6QXoi1bgIS5IkiWui5QAvw="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
